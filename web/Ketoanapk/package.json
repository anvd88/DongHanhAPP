{
  "name": "ketoanapk",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:local": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode android",
    "cap:sync": "npm run build:android && cap sync android",
    "apk:debug": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "lint": "eslint .",
    "preview": "vite preview"
  },
