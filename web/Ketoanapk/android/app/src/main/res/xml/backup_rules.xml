<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup (Android < 12): KHÔNG sao lưu phiên đăng nhập (token JWT) lên cloud. -->
<full-backup-content>
    <exclude domain="file" path="datastore/ketoanapk_session.preferences_pb" />
    <!-- Thông báo nghiệp vụ có ngày công/nội dung đơn; không mang sang thiết bị hay tài khoản khác. -->
    <exclude domain="file" path="datastore/ketoanapk_notifications.preferences_pb" />
    <exclude domain="file" path="request_drafts.bin" />
</full-backup-content>
