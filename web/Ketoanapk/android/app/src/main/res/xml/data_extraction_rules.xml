<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: loại phiên đăng nhập (token JWT) khỏi cả sao lưu cloud lẫn chuyển máy. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/ketoanapk_session.preferences_pb" />
        <exclude domain="file" path="datastore/ketoanapk_notifications.preferences_pb" />
        <exclude domain="file" path="request_drafts.bin" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/ketoanapk_session.preferences_pb" />
        <exclude domain="file" path="datastore/ketoanapk_notifications.preferences_pb" />
        <exclude domain="file" path="request_drafts.bin" />
    </device-transfer>
</data-extraction-rules>
