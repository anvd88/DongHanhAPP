<?xml version="1.0" encoding="utf-8"?>
<!--
  Camera preview stays edge-to-edge. Interactive controls receive system-bar/cutout insets in
  QrLoginCaptureActivity so the scanner remains usable on Android 15+ and gesture-navigation devices.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/qr_capture_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <androidx.camera.view.PreviewView
        android:id="@+id/qr_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <com.ketoanapk.hr.ui.QrOverlayView
        android:id="@+id/qr_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/qr_top_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/qr_exit_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/qr_result_close_button"
                android:backgroundTint="@null"
                android:contentDescription="@string/qr_close_scanner"
                android:padding="12dp"
                android:src="@drawable/ic_qr_close"
                android:stateListAnimator="@null"
                android:tooltipText="@string/qr_close_scanner" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:background="@drawable/qr_top_pill_background"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:text="@string/qr_screen_title"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/qr_gallery_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/qr_result_close_button"
                android:backgroundTint="@null"
                android:contentDescription="@string/qr_pick_image"
                android:padding="12dp"
                android:src="@drawable/ic_qr_gallery"
                android:stateListAnimator="@null"
                android:tooltipText="@string/qr_pick_image" />
        </LinearLayout>

        <TextView
            android:id="@+id/qr_status_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="10dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/qr_status_background"
            android:gravity="center"
            android:maxLines="2"
            android:paddingHorizontal="16dp"
            android:paddingVertical="9dp"
            android:text="@string/qr_default_prompt"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/qr_torch_button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/qr_result_close_button"
        android:backgroundTint="@null"
        android:minHeight="48dp"
        android:minWidth="48dp"
        android:paddingHorizontal="20dp"
        android:stateListAnimator="@null"
        android:text="@string/qr_torch_on"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/qr_result_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginTop="24dp"
        android:accessibilityPaneTitle="@string/qr_result_pane"
        android:background="@drawable/qr_result_sheet_background"
        android:elevation="18dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/qr_result_card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/qr_result_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:textColor="#75A4FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="10dp"
                android:fadeScrollbars="false"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/qr_result_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@android:color/white"
                    android:textIsSelectable="true"
                    android:textSize="16sp" />
            </ScrollView>
        </LinearLayout>

        <Button
            android:id="@+id/qr_open_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/qr_result_copy_button"
            android:backgroundTint="@null"
            android:drawableStart="@drawable/ic_qr_open"
            android:drawablePadding="10dp"
            android:gravity="center"
            android:minHeight="56dp"
            android:minWidth="48dp"
            android:paddingHorizontal="18dp"
            android:stateListAnimator="@null"
            android:text="@string/qr_open_link"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="ButtonStyle">

            <Button
                android:id="@+id/qr_copy_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/qr_result_close_button"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_qr_copy"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:minHeight="52dp"
                android:minWidth="48dp"
                android:paddingHorizontal="14dp"
                android:stateListAnimator="@null"
                android:text="@string/qr_copy"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/qr_close_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/qr_result_close_button"
                android:backgroundTint="@null"
                android:gravity="center"
                android:minHeight="52dp"
                android:minWidth="48dp"
                android:paddingHorizontal="14dp"
                android:stateListAnimator="@null"
                android:text="@string/qr_scan_next"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
