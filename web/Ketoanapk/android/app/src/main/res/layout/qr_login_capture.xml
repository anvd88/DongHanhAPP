<?xml version="1.0" encoding="utf-8"?>
<!--
  Màn quét QR chạy trên CameraX (thay cụm Camera1 của zxing). PreviewView dùng FILL_CENTER +
  PERFORMANCE để khớp đúng cách QrLoginCaptureActivity quy đổi toạ độ ML Kit sang toạ độ màn hình.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/qr_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <com.ketoanapk.hr.ui.QrOverlayView
        android:id="@+id/qr_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/qr_status_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="28dp"
        android:background="@android:color/transparent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="Đưa mã QR vào khung"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

    <!-- Bật đèn pin: kho/phòng tối là lý do hỏng quét phổ biến nhất mà người dùng tự khắc phục được.
         Ẩn đi khi máy không có đèn hoặc khi bảng kết quả đang che phần dưới màn hình. -->
    <Button
        android:id="@+id/qr_torch_button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/qr_result_close_button"
        android:backgroundTint="@null"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="20dp"
        android:stateListAnimator="@null"
        android:text="Bật đèn"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/qr_result_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginTop="24dp"
        android:background="@drawable/qr_result_sheet_background"
        android:elevation="18dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <View
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/qr_result_drag_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/qr_result_card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/qr_result_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#5A91FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="10dp"
                android:fadeScrollbars="false"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/qr_result_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@android:color/white"
                    android:textSize="17sp" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/qr_copy_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/qr_result_copy_button"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_qr_copy"
                android:drawablePadding="10dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="18dp"
                android:stateListAnimator="@null"
                android:text="Sao chép"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/qr_close_button"
                android:layout_width="92dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/qr_result_close_button"
                android:backgroundTint="@null"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="Đóng"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
