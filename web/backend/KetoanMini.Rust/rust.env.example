# Listener riêng; TLS kết thúc tại front proxy cùng máy.
KETOANMINI_RUST_BIND=127.0.0.1:5240

# Backend .NET sidecar trong giai đoạn chuyển đổi. Chỉ loopback HTTP được chấp nhận.
KETOANMINI_COMPAT_UPSTREAM=http://127.0.0.1:5239

# Không commit giá trị thật. Có thể bỏ hai dòng KETOANMINI_* và dùng lại các biến __ của .NET.
KETOANMINI_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/ketoanmini
KETOANMINI_JWT_KEY=REPLACE_WITH_THE_SAME_RANDOM_KEY_AS_DOTNET_AT_LEAST_32_BYTES

Jwt__Issuer=KetoanMini.Web
Jwt__Audience=KetoanMini.Web
Jwt__WebExpireHours=168
Security__SessionIdleDays=7
Security__CookieAuth=true

KETOANMINI_DB_MIN_CONNECTIONS=0
KETOANMINI_DB_MAX_CONNECTIONS=20
KETOANMINI_DB_ACQUIRE_TIMEOUT_MS=3000
RUST_LOG=ketoanmini_server=info,tower_http=info,hyper_util=warn
