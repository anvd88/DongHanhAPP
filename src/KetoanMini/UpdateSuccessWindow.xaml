<Window x:Class="KetoanMini.UpdateSuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cập nhật thành công"
        Width="960" Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Gradient xanh cho nút "Hoàn tất" -->
        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3478F6" Offset="0"/>
            <GradientStop Color="#1757EA" Offset="1"/>
        </LinearGradientBrush>

        <!-- Gradient xanh dương cho icon tròn ở thanh tiêu đề -->
        <LinearGradientBrush x:Key="TitleIconBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3478F6" Offset="0"/>
            <GradientStop Color="#1757EA" Offset="1"/>
        </LinearGradientBrush>

        <!-- Gradient xanh lá cho vòng tròn thành công -->
        <LinearGradientBrush x:Key="SuccessBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#34D27B" Offset="0"/>
            <GradientStop Color="#16A34A" Offset="1"/>
        </LinearGradientBrush>

        <!-- Nút nền trắng có viền (Đóng) -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Foreground" Value="#071338"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F5F7FB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút gradient xanh (Hoàn tất) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#1757EA" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút đóng (X) tròn, hover nền xám nhạt -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="19">
                            <Path Data="M7,7 L19,19 M19,7 L7,19" Stroke="#737B8C" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fade-in nhẹ khi mở cửa sổ -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.28"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Lề ngoài trong suốt, chỉ chừa chỗ cho bóng đổ mềm (không phủ nền kín cửa sổ). -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid Margin="30">
            <!-- Lớp đổ bóng riêng -->
            <Border Background="#F6FAFF" CornerRadius="20" Margin="4">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="34" ShadowDepth="0" Opacity="0.20"/>
                </Border.Effect>
            </Border>

            <!-- Khung chính trắng hơi xanh -->
            <Border Background="#F6FAFF" CornerRadius="20">
                <Grid Margin="40,26,40,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Thanh tiêu đề -->
                    <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="38" Height="38" VerticalAlignment="Center">
                                <Ellipse Fill="{StaticResource TitleIconBrush}"/>
                                <Viewbox Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M12,3 L21,12 L16,12 L16,21 L8,21 L8,12 L3,12 Z" Fill="White"/>
                                </Viewbox>
                            </Grid>
                            <TextBlock x:Name="TxtHeader" Text="Bắt buộc cập nhật" FontSize="21" FontWeight="Bold"
                                       Foreground="#737B8C" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource CloseButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseButton_Click"/>
                    </Grid>

                    <!-- Icon thành công: glow + vòng tròn xanh lá + dấu check + chấm nhỏ -->
                    <Grid Grid.Row="1" Width="170" Height="170" HorizontalAlignment="Center" Margin="0,6,0,2">
                        <!-- glow ngoài -->
                        <Ellipse Width="170" Height="170" Fill="#E3F7EC"/>
                        <Ellipse Width="134" Height="134" Fill="#CFF0DC"/>
                        <!-- vòng tròn xanh lá chính -->
                        <Ellipse Width="104" Height="104" Fill="{StaticResource SuccessBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#22C55E" BlurRadius="24" ShadowDepth="0" Opacity="0.5"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <!-- dấu check trắng -->
                        <Viewbox Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M5,13 L11,19 L21,6" Stroke="White" StrokeThickness="2.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Viewbox>
                        <!-- vài chấm tròn nhỏ điểm nhấn -->
                        <Ellipse Width="9" Height="9" Fill="#34D27B" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,40,0,0"/>
                        <Ellipse Width="7" Height="7" Fill="#7BDFA6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,34,0"/>
                        <Ellipse Width="8" Height="8" Fill="#34D27B" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,44"/>
                        <Ellipse Width="6" Height="6" Fill="#7BDFA6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,0,30"/>
                    </Grid>

                    <!-- Tiêu đề chính -->
                    <TextBlock Grid.Row="2" Text="Cập nhật thành công" FontSize="42" FontWeight="Bold"
                               Foreground="#071338" HorizontalAlignment="Center" Margin="0,8,0,2"/>

                    <!-- Mô tả phụ -->
                    <TextBlock Grid.Row="3"
                               Text="Hệ thống đã cập nhật lên phiên bản mới. Bạn có thể tiếp tục sử dụng ứng dụng ngay bây giờ."
                               FontSize="17" Foreground="#6E778C" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="640" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                    <!-- Khu vực phiên bản -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Border Background="#F0F2F7" CornerRadius="11" Padding="22,11,22,11">
                            <TextBlock FontSize="16" Foreground="#5B6472" VerticalAlignment="Center">
                                <Run Text="Phiên bản cũ: "/><Run x:Name="RunOld" Text="1.2.0" FontWeight="Bold" Foreground="#071338"/>
                            </TextBlock>
                        </Border>
                        <Viewbox Width="22" Height="22" Margin="14,0,14,0" VerticalAlignment="Center">
                            <Path Data="M3,11 L17,11 M12,5 L18,11 L12,17" Stroke="#9AA3B2" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Viewbox>
                        <Border Background="#E3F7EC" CornerRadius="11" Padding="22,11,22,11">
                            <TextBlock FontSize="16" Foreground="#15803D" VerticalAlignment="Center">
                                <Run Text="Phiên bản hiện tại: "/><Run x:Name="RunCurrent" Text="1.2.1" FontWeight="Bold" Foreground="#15803D"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Tiêu đề trạng thái -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,22,0,10">
                        <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                            <Path Data="M7,5 L19,5 M7,11 L19,11 M7,17 L19,17 M3,5 L4.4,5 M3,11 L4.4,11 M3,17 L4.4,17"
                                  Stroke="#2F6BFF" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <TextBlock Text="Trạng thái cập nhật" FontSize="21" FontWeight="SemiBold"
                                   Foreground="#071338" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Khung 3 bước (đều hoàn thành) -->
                    <Border Grid.Row="6" Background="#FCFDFF" BorderBrush="#D6DCE8" BorderThickness="1"
                            CornerRadius="15" Padding="24,16,24,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="30" Height="30">
                                    <Ellipse Fill="{StaticResource SuccessBrush}"/>
                                    <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M4,11 L9,16 L18,5" Stroke="White" StrokeThickness="2.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Viewbox>
                                </Grid>
                                <TextBlock Text="Kiểm tra phiên bản" FontSize="16" FontWeight="SemiBold"
                                           Foreground="#334155" VerticalAlignment="Center" Margin="11,0,0,0"/>
                            </StackPanel>

                            <Rectangle Grid.Column="1" Width="1" Fill="#E1E7F1" Margin="16,4,16,4"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="30" Height="30">
                                    <Ellipse Fill="{StaticResource SuccessBrush}"/>
                                    <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M4,11 L9,16 L18,5" Stroke="White" StrokeThickness="2.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Viewbox>
                                </Grid>
                                <TextBlock Text="Tải bản cập nhật" FontSize="16" FontWeight="SemiBold"
                                           Foreground="#334155" VerticalAlignment="Center" Margin="11,0,0,0"/>
                            </StackPanel>

                            <Rectangle Grid.Column="3" Width="1" Fill="#E1E7F1" Margin="16,4,16,4"/>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="30" Height="30">
                                    <Ellipse Fill="{StaticResource SuccessBrush}"/>
                                    <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M4,11 L9,16 L18,5" Stroke="White" StrokeThickness="2.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Viewbox>
                                </Grid>
                                <TextBlock Text="Cài đặt" FontSize="16" FontWeight="SemiBold"
                                           Foreground="#334155" VerticalAlignment="Center" Margin="11,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Dòng thông báo hoàn tất -->
                    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Grid Width="24" Height="24" VerticalAlignment="Center">
                            <Ellipse Stroke="#16A34A" StrokeThickness="1.6"/>
                            <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M4,11 L9,16 L18,5" Stroke="#16A34A" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Grid>
                        <TextBlock x:Name="TxtSuccess" Text="Cài đặt hoàn tất. Không phát hiện lỗi."
                                   FontSize="18" FontWeight="SemiBold" Foreground="#15803D"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Nút dưới cùng -->
                    <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Button x:Name="BtnClose2" Style="{StaticResource OutlineButtonStyle}"
                                Width="230" Height="62" Margin="0,0,18,0"
                                Background="White" BorderBrush="#D5DBE6" BorderThickness="1"
                                Click="BtnClose2_Click">
                            <TextBlock Text="Đóng" FontSize="19" FontWeight="SemiBold" Foreground="#071338"/>
                        </Button>

                        <Button x:Name="BtnFinish" Style="{StaticResource PrimaryButtonStyle}"
                                Width="270" Height="62" Click="BtnFinish_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="24" Height="24" VerticalAlignment="Center">
                                    <Ellipse Stroke="White" StrokeThickness="1.6" Opacity="0.85"/>
                                    <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M4,11 L9,16 L18,5" Stroke="White" StrokeThickness="2.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Viewbox>
                                </Grid>
                                <TextBlock Text="Hoàn tất" FontSize="19" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
