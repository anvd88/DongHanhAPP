<Window x:Class="KetoanMini.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Có gì mới"
        Width="960" Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Gradient xanh dùng cho nút chính / icon vector dự phòng -->
        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3478F6" Offset="0"/>
            <GradientStop Color="#1757EA" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ArrowGlossBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F2F7FF" Offset="0"/>
            <GradientStop Color="#C7DCFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Nút nền trắng có viền (Thoát / Để sau) -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Foreground" Value="#071338"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F5F7FB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút gradient xanh (Cập nhật ngay) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#1757EA" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.93"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút đóng (X) tròn, hover nền xám nhạt -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="19">
                            <Path Data="M7,7 L19,19 M19,7 L7,19"
                                  Stroke="#737B8C" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Lề ngoài chừa chỗ cho bóng đổ + lớp nền tối nhẹ phía sau cửa sổ -->
    <Grid>
        <!-- Lớp nền mờ tối nhẹ (mô phỏng blur phía sau dialog) -->
        <Rectangle Fill="#33000000"/>

        <Grid Margin="30">
            <!-- Lớp đổ bóng riêng (không gắn effect lên card chứa nội dung để chữ không bị mờ) -->
            <Border Background="#F6FAFF" CornerRadius="20" Margin="4">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="34" ShadowDepth="0" Opacity="0.20"/>
                </Border.Effect>
            </Border>

            <!-- Khung chính trắng hơi xanh -->
            <Border Background="#F6FAFF" CornerRadius="20">
                <Grid Margin="38,28,38,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Thanh tiêu đề -->
                    <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Icon cạnh tiêu đề: ưu tiên ảnh PNG (ảnh 3), fallback vector -->
                            <Grid Width="40" Height="40" VerticalAlignment="Center">
                                <Grid x:Name="TitleIconFallback">
                                    <Ellipse Fill="{StaticResource PrimaryBrush}"/>
                                    <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M12,3 L21,12 L16,12 L16,21 L8,21 L8,12 L3,12 Z" Fill="White"/>
                                    </Viewbox>
                                </Grid>
                                <Image x:Name="TitleIconImage" Stretch="Uniform" Visibility="Collapsed"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <TextBlock Text="Có gì mới !!!" FontSize="21" FontWeight="Bold"
                                       Foreground="#737B8C" VerticalAlignment="Center"
                                       Margin="14,0,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource CloseButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="CloseButton_Click"/>
                    </Grid>

                    <!-- Logo hero: ưu tiên ảnh PNG (ảnh 2), fallback vector vòng tròn + mũi tên + badge "!" -->
                    <Grid Grid.Row="1" Width="172" Height="172" HorizontalAlignment="Center" Margin="0,10,0,6">
                        <Grid x:Name="HeroFallback">
                            <Ellipse Width="168" Height="168" Fill="#ECF3FF"/>
                            <Ellipse Width="168" Height="168" Stroke="#DCEAFF" StrokeThickness="1.5"/>
                            <Ellipse Width="118" Height="118" Fill="#D6E6FF" Opacity="0.65">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#7FB0FF" BlurRadius="26" ShadowDepth="0" Opacity="0.5"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Viewbox Width="60" Height="66" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0">
                                <Path Data="M12,3 L21,12 L16,12 L16,21 L8,21 L8,12 L3,12 Z"
                                      Fill="{StaticResource ArrowGlossBrush}"
                                      Stroke="#AFCBF5" StrokeThickness="0.6"/>
                            </Viewbox>
                            <Grid Width="46" Height="46" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,10">
                                <Ellipse Fill="White"/>
                                <Ellipse Width="38" Height="38" Fill="#2F6BFF"/>
                                <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                            </Grid>
                        </Grid>
                        <Image x:Name="HeroImage" Stretch="Uniform" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect Color="#7FB0FF" BlurRadius="22" ShadowDepth="0" Opacity="0.35"/>
                            </Image.Effect>
                        </Image>
                    </Grid>

                    <!-- Tiêu đề lớn -->
                    <TextBlock Grid.Row="2" Text="Có phiên bản mới"
                               FontSize="40" FontWeight="Bold" Foreground="#071338"
                               HorizontalAlignment="Center" Margin="0,4,0,4"/>

                    <!-- Khu vực phiên bản -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Border Background="#F0F2F7" CornerRadius="11" Padding="22,12,22,12">
                            <TextBlock FontSize="16" Foreground="#5B6472" VerticalAlignment="Center">
                                <Run Text="Phiên bản hiện tại: "/><Run x:Name="RunCurrent" FontWeight="Bold" Foreground="#071338"/>
                            </TextBlock>
                        </Border>
                        <Viewbox Width="22" Height="22" Margin="14,0,14,0" VerticalAlignment="Center">
                            <Path Data="M3,11 L17,11 M12,5 L18,11 L12,17"
                                  Stroke="#9AA3B2" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Viewbox>
                        <Border Background="#E6F0FF" CornerRadius="11" Padding="22,12,22,12">
                            <TextBlock FontSize="16" Foreground="#1757EA" VerticalAlignment="Center">
                                <Run Text="Phiên bản mới: "/><Run x:Name="RunNew" FontWeight="Bold" Foreground="#1757EA"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Tiêu đề nội dung cập nhật -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,26,0,10">
                        <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                            <Path Data="M7,5 L19,5 M7,11 L19,11 M7,17 L19,17 M3,5 L4.4,5 M3,11 L4.4,11 M3,17 L4.4,17"
                                  Stroke="#2F6BFF" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <TextBlock Text="Nội dung cập nhật" FontSize="21" FontWeight="SemiBold"
                                   Foreground="#071338" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Hộp nội dung cập nhật -->
                    <Border Grid.Row="5" Background="#FCFDFF" BorderBrush="#D6DCE8" BorderThickness="1"
                            CornerRadius="12" Padding="18" MinHeight="170" Margin="0,0,0,4">
                        <TextBox x:Name="TxtNotes"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#5B6472"
                                 FontSize="17"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 Text="(Không có ghi chú)"/>
                    </Border>

                    <!-- Khu vực nút / tiến trình -->
                    <Grid Grid.Row="6" Margin="0,22,0,0">
                        <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="BtnLater" Style="{StaticResource OutlineButtonStyle}"
                                    Width="230" Height="62" Margin="0,0,18,0"
                                    Background="White" BorderBrush="#D5DBE6" BorderThickness="1"
                                    Click="BtnLater_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                        <Path Data="M5,5 L15,15 M15,5 L5,15" Stroke="#071338" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                    <TextBlock x:Name="TxtLater" Text="Thoát" FontSize="19" FontWeight="SemiBold"
                                               Foreground="#071338" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnUpdate" Style="{StaticResource PrimaryButtonStyle}"
                                    Width="260" Height="62"
                                    Click="BtnUpdate_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                        <Path Data="M11,3 L11,14 M6,9.5 L11,14.5 L16,9.5 M4,18 L18,18"
                                              Stroke="White" StrokeThickness="1.9"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Viewbox>
                                    <TextBlock x:Name="TxtUpdate" Text="Cập nhật ngay" FontSize="19" FontWeight="SemiBold"
                                               Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
