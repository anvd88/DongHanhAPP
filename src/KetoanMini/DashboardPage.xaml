<UserControl x:Class="KetoanMini.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7FB"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.10" Color="#1B2A46"/>
        <DropShadowEffect x:Key="CardHoverShadow" BlurRadius="18" ShadowDepth="3" Opacity="0.16" Color="#246BEE"/>

        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DFE6F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="MinHeight" Value="136"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#BFD7FF"/>
                    <Setter Property="Effect" Value="{StaticResource CardHoverShadow}"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="-2"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconBoxStyle" TargetType="Border">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#71809C"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#081735"/>
            <Setter Property="FontSize" Value="31"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style x:Key="StatSubStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8492AA"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="AlternatingRowBackground" Value="#FCFDFE"/>
            <Setter Property="Foreground" Value="#20304D"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F6FB"/>
            <Setter Property="Foreground" Value="#152443"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#DFE6EF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#20304D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F5FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E5EEFF"/>
                    <Setter Property="Foreground" Value="#0B3E9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,26,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Tổng quan"
                           Foreground="#071736"
                           FontSize="31"
                           FontWeight="Bold"/>
                <TextBlock x:Name="WelcomeText"
                           Text="Chào mừng trở lại"
                           Foreground="#8795AD"
                           FontSize="14"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconBoxStyle}" Background="#E4EEFF">
                            <Path Data="M8,19 C8,16 10,14 13,14 L17,14 C20,14 22,16 22,19 M11,8 A4,4 0 1 1 19,8 A4,4 0 1 1 11,8 M2,19 C2,16.8 3.8,15.2 6.2,15.1"
                                  Stroke="#1765E8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Stretch="Uniform" Width="25" Height="25"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Khách hàng" Style="{StaticResource StatLabelStyle}"/>
                            <TextBlock x:Name="CustomersValue" Text="0" Style="{StaticResource StatValueStyle}"/>
                            <Grid>
                                <TextBlock Text="Đang hoạt động" Style="{StaticResource StatSubStyle}"/>
                                <Border HorizontalAlignment="Right" Background="#DDF9EC" CornerRadius="8" Padding="8,3" Margin="0,0,0,0">
                                    <TextBlock Text="▲ 5.5%" Foreground="#11A36B" FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconBoxStyle}" Background="#DDF8EC">
                            <Path Data="M7,3 L17,3 L22,8 L22,21 L7,21 Z M17,3 L17,8 L22,8 M11,12 L18,12 M11,16 L18,16"
                                  Stroke="#00A76F" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Stretch="Uniform" Width="25" Height="25"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Chứng từ" Style="{StaticResource StatLabelStyle}"/>
                            <TextBlock x:Name="DocumentsValue" Text="0" Style="{StaticResource StatValueStyle}"/>
                            <TextBlock Text="Tổng phiếu" Style="{StaticResource StatSubStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconBoxStyle}" Background="#FFF1C9">
                            <Path Data="M12,3 C7,3 4,6.2 4,11 C4,15.8 7,19 12,19 C17,19 20,15.8 20,11 C20,6.2 17,3 12,3 Z M12,7 L12,15 M9,9 C9.6,8.2 10.7,7.8 12,7.8 C13.8,7.8 15,8.6 15,9.8 C15,12.4 9,11 9,13.6 C9,14.8 10.2,15.5 12,15.5 C13.3,15.5 14.4,15.1 15.1,14.2"
                                  Stroke="#9B6500" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Stretch="Uniform" Width="25" Height="25"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Thu chi" Style="{StaticResource StatLabelStyle}"/>
                            <TextBlock x:Name="PaymentsValue" Text="0" Style="{StaticResource StatValueStyle}"/>
                            <TextBlock Text="Tổng thanh toán" Style="{StaticResource StatSubStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconBoxStyle}" Background="#EEE6FF">
                            <Path Data="M4,19 L20,19 M7,16 L7,12 M12,16 L12,6 M17,16 L17,9 M6,9 L11,5 L15,8 L20,4"
                                  Stroke="#6333B9" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Stretch="Uniform" Width="25" Height="25"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Doanh thu tháng" Style="{StaticResource StatLabelStyle}"/>
                            <TextBlock x:Name="MonthlyRevenueValue" Text="0" Style="{StaticResource StatValueStyle}"/>
                            <TextBlock x:Name="MonthlyRevenueSub" Text="Tháng" Style="{StaticResource StatSubStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="4"
                    Background="#FFFFFF"
                    BorderBrush="#DDE5EF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16"
                    MinHeight="330"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Hoạt động gần đây"
                                   Foreground="#0B1C3D"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Width="34"
                                Height="34"
                                HorizontalAlignment="Right"
                                Background="#FFFFFF"
                                BorderBrush="#DCE4EF"
                                BorderThickness="1"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="9">
                                        <Path Data="M5,7 L19,7 M8,12 L16,12 M10,17 L14,17"
                                              Stroke="#73839B"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Stretch="Uniform"
                                              Width="18"
                                              Height="18"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <DataGrid x:Name="ActivityGrid"
                              Grid.Row="1"
                              Style="{StaticResource ModernDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Số phiếu" Binding="{Binding VoucherNo}" Width="130"/>
                            <DataGridTextColumn Header="Ngày" Binding="{Binding Date}" Width="115"/>
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding Customer}" Width="220"/>
                            <DataGridTextColumn Header="Nội dung" Binding="{Binding Content}" Width="*"/>
                            <DataGridTextColumn Header="Tổng tiền" Binding="{Binding Total}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
