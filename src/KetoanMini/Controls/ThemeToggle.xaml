<UserControl x:Class="KetoanMini.ThemeToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="68"
             Height="32"
             Focusable="False">
    <Button x:Name="RootButton"
            Padding="0"
            BorderThickness="0"
            Background="Transparent"
            Cursor="Hand"
            ToolTip="Đổi chế độ sáng/tối">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <ContentPresenter/>
            </ControlTemplate>
        </Button.Template>
        <Grid Width="68" Height="32">
            <Border x:Name="Track"
                    CornerRadius="16"
                    Background="#07101F"
                    BorderBrush="#23466F"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.22" Color="#020817"/>
                </Border.Effect>
            </Border>

            <Grid Width="19"
                  Height="19"
                  HorizontalAlignment="Left"
                  Margin="9,6.5,0,0"
                  IsHitTestVisible="False">
                <Ellipse Width="10" Height="10" Fill="#FDBA3B" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.55" Color="#FACC15"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Path Stroke="#FDE68A" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M11,0 L11,4 M11,18 L11,22 M0,11 L4,11 M18,11 L22,11 M3.2,3.2 L6,6 M16,16 L18.8,18.8 M18.8,3.2 L16,6 M6,16 L3.2,18.8"/>
            </Grid>

            <Border x:Name="Knob"
                    Width="26"
                    Height="26"
                    CornerRadius="13"
                    HorizontalAlignment="Left"
                    Margin="3,3,0,0"
                    Background="#F8FBFF"
                    BorderBrush="#9BC6FF"
                    BorderThickness="1.2"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.32" Color="#1D4ED8"/>
                </Border.Effect>
                <Grid>
                    <Path x:Name="MoonPath"
                          Width="15"
                          Height="15"
                          Fill="#2563EB"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M14.5,2 C10.7,2.7 7.8,6.1 7.8,10.1 C7.8,14.8 11.6,18.6 16.3,18.6 C17.5,18.6 18.7,18.3 19.7,17.8 C18.1,20.3 15.3,22 12.1,22 C7.1,22 3,17.9 3,12.9 C3,8.1 6.8,4.1 11.5,3.9 C12.5,3.8 13.5,3.2 14.5,2 Z"/>
                    <Path x:Name="SunPath"
                          Width="15"
                          Height="15"
                          Stroke="#F59E0B"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M12,7 A5,5 0 1 1 12,17 A5,5 0 1 1 12,7 M12,1 L12,4 M12,20 L12,23 M1,12 L4,12 M20,12 L23,12 M4.2,4.2 L6.4,6.4 M17.6,17.6 L19.8,19.8 M19.8,4.2 L17.6,6.4 M6.4,17.6 L4.2,19.8"/>
                </Grid>
            </Border>
        </Grid>
    </Button>
</UserControl>
