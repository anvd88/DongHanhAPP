<UserControl x:Class="KetoanMini.SidebarMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="260"
             MinWidth="250"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="SidebarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#091732" Offset="0"/>
            <GradientStop Color="#07142D" Offset="0.52"/>
            <GradientStop Color="#0B1D45" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AvatarBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4F8FFF" Offset="0"/>
            <GradientStop Color="#2E67EE" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ActiveItemBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4B8DFF" Offset="0"/>
            <GradientStop Color="#2D67F1" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="SidebarShadow" BlurRadius="22" ShadowDepth="2" Opacity="0.34" Color="#020817"/>
        <DropShadowEffect x:Key="AvatarGlow" BlurRadius="18" ShadowDepth="0" Opacity="0.32" Color="#60A5FA"/>
        <DropShadowEffect x:Key="ActiveGlow" BlurRadius="14" ShadowDepth="2" Opacity="0.32" Color="#3B82F6"/>

        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7E97C8"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,7,0,3"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>

        <Style x:Key="SidebarMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#12264E"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2A4A7B"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ActiveItemBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#6EA8FF"/>
                                <Setter TargetName="ItemBorder" Property="Effect" Value="{StaticResource ActiveGlow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarFeaturedButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarMenuButtonStyle}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,1,0,8"/>
            <Setter Property="Background" Value="#162B56"/>
            <Setter Property="BorderBrush" Value="#27467A"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4,4,4,4">
        <Border CornerRadius="0"
                BorderBrush="#29497A"
                BorderThickness="1"
                Background="{StaticResource SidebarBackgroundBrush}"
                Effect="{StaticResource SidebarShadow}"
                ClipToBounds="False">
            <DockPanel LastChildFill="True" Margin="16,16,16,12">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="52"
                            Height="52"
                            CornerRadius="26"
                            Background="{StaticResource AvatarBrush}"
                            BorderBrush="#8AB9FF"
                            BorderThickness="1"
                            Effect="{StaticResource AvatarGlow}">
                        <TextBlock Text="CP"
                                   Foreground="#FFFFFF"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Công ty TNHH"
                                   Foreground="#F7FAFF"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   LineHeight="17"/>
                        <TextBlock Text="Inox Cường Phát"
                                   Foreground="#F7FAFF"
                                   FontSize="14.5"
                                   FontWeight="Bold"
                                   LineHeight="17"/>
                        <TextBlock Text="Hệ thống quản lý kế toán"
                                   Foreground="#9FB3D9"
                                   FontSize="10.8"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <Border DockPanel.Dock="Bottom"
                        Height="31"
                        Margin="0,8,0,0"
                        Background="#09275C"
                        CornerRadius="10"
                        Padding="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#20D98B">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.55" Color="#20D98B"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="VersionText"
                                   Text="Phiên bản"
                                   Foreground="#AFC1DF"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="MenuPanel"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
