<Window x:Class="KetoanMini.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đang cập nhật"
        Width="960" Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Gradient xanh cho nút chính + icon -->
        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3478F6" Offset="0"/>
            <GradientStop Color="#1757EA" Offset="1"/>
        </LinearGradientBrush>

        <!-- Gradient cho vòng tròn xanh ở giữa -->
        <LinearGradientBrush x:Key="HeroBlue" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4C8DFF" Offset="0"/>
            <GradientStop Color="#1E63F0" Offset="1"/>
        </LinearGradientBrush>

        <!-- Gradient cho cung tròn xoay -->
        <LinearGradientBrush x:Key="ArcBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5C97FF" Offset="0"/>
            <GradientStop Color="#1757EA" Offset="1"/>
        </LinearGradientBrush>

        <!-- Gradient cho thanh tiến trình -->
        <LinearGradientBrush x:Key="ProgressFill" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4C8DFF" Offset="0"/>
            <GradientStop Color="#1757EA" Offset="1"/>
        </LinearGradientBrush>

        <!-- Nút nền trắng có viền (Thoát) -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Foreground" Value="#071338"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F5F7FB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút gradient xanh (Đang cập nhật) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#1757EA" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút đóng (X) tròn, hover nền xám nhạt -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="19">
                            <Path Data="M7,7 L19,19 M19,7 L7,19"
                                  Stroke="#737B8C" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2F7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thanh tiến trình bo góc, gradient xanh -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="#E7EDF7"/>
            <Setter Property="Foreground" Value="{StaticResource ProgressFill}"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="9" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="9"
                                    Background="{TemplateBinding Foreground}">
                                <!-- shimmer mềm chạy ngang -->
                                <Border CornerRadius="9" ClipToBounds="True">
                                    <Rectangle x:Name="Shimmer" Width="120" HorizontalAlignment="Left">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform x:Name="ShimmerShift" X="-160"/>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Border>
                            </Border>
                        </Grid>
                        <!-- Shimmer phải animate TRONG template vì 'ShimmerShift' nằm ở namescope riêng của template -->
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ShimmerShift"
                                                         Storyboard.TargetProperty="X"
                                                         From="-160" To="900" Duration="0:0:1.6"
                                                         RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Animation: cung xoay quanh icon + icon loading trên nút + shimmer -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Cung xanh xoay liên tục quanh mũi tên -->
                    <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:1.4"
                                     RepeatBehavior="Forever"/>
                    <!-- Icon loading nhỏ trên nút "Đang cập nhật" -->
                    <DoubleAnimation Storyboard.TargetName="BtnSpinnerRotate"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:1.1"
                                     RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Lớp nền tối nhẹ phía sau (mô phỏng blur) -->
    <Grid>
        <Rectangle Fill="#33000000"/>

        <Grid Margin="30">
            <!-- Lớp đổ bóng -->
            <Border Background="#F6FAFF" CornerRadius="20" Margin="4">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="34" ShadowDepth="0" Opacity="0.20"/>
                </Border.Effect>
            </Border>

            <!-- Khung chính -->
            <Border Background="#F6FAFF" CornerRadius="20">
                <Grid Margin="40,26,40,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Thanh tiêu đề -->
                    <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="38" Height="38" VerticalAlignment="Center">
                                <Ellipse Fill="{StaticResource PrimaryBrush}"/>
                                <Viewbox Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M12,3 L21,12 L16,12 L16,21 L8,21 L8,12 L3,12 Z" Fill="White"/>
                                </Viewbox>
                            </Grid>
                            <TextBlock x:Name="TxtHeader" Text="Bắt buộc cập nhật" FontSize="21" FontWeight="Bold"
                                       Foreground="#737B8C" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>

                        <Button x:Name="BtnClose" Grid.Column="1" Style="{StaticResource CloseButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="CloseButton_Click"/>
                    </Grid>

                    <!-- Icon chính: vòng mờ + cung xoay + chấm + vòng xanh + mũi tên -->
                    <Grid Grid.Row="1" Width="150" Height="150" HorizontalAlignment="Center" Margin="0,6,0,2">
                        <!-- Vòng mờ ngoài cùng -->
                        <Ellipse Width="150" Height="150" Fill="#EAF2FF"/>
                        <!-- Vòng nền nhạt cho cung -->
                        <Ellipse Width="132" Height="132" Stroke="#E1EAF9" StrokeThickness="6"/>
                        <!-- Cung xanh xoay + chấm điểm nhấn -->
                        <Viewbox x:Name="SpinnerBox" Width="132" Height="132" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                            </Viewbox.RenderTransform>
                            <Canvas Width="100" Height="100">
                                <Path Stroke="{StaticResource ArcBrush}" StrokeThickness="6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 50,6 A 44,44 0 1 1 6,50"/>
                                <Ellipse Canvas.Left="1.5" Canvas.Top="45.5" Width="9" Height="9" Fill="#1E63F0"/>
                            </Canvas>
                        </Viewbox>
                        <!-- Vòng tròn xanh + mũi tên trắng (đứng yên) -->
                        <Grid Width="92" Height="92">
                            <Ellipse Fill="{StaticResource HeroBlue}">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#2F6BFF" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Viewbox Width="40" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M12,3 L21,12 L16,12 L16,21 L8,21 L8,12 L3,12 Z" Fill="White"/>
                            </Viewbox>
                        </Grid>
                    </Grid>

                    <!-- Tiêu đề chính -->
                    <TextBlock Grid.Row="2" Text="Đang cập nhật..."
                               FontSize="42" FontWeight="Bold" Foreground="#071338"
                               HorizontalAlignment="Center" Margin="0,8,0,2"/>

                    <!-- Mô tả phụ -->
                    <TextBlock Grid.Row="3"
                               Text="Hệ thống đang tải và cài đặt phiên bản mới. Vui lòng chờ trong giây lát."
                               FontSize="17" Foreground="#6E778C"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>

                    <!-- Khu vực phiên bản -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Border Background="#F0F2F7" CornerRadius="11" Padding="22,12,22,12">
                            <TextBlock FontSize="16" Foreground="#5B6472" VerticalAlignment="Center">
                                <Run Text="Phiên bản hiện tại: "/><Run x:Name="RunCurrent" Text="1.2.0" FontWeight="Bold" Foreground="#071338"/>
                            </TextBlock>
                        </Border>
                        <Viewbox Width="22" Height="22" Margin="14,0,14,0" VerticalAlignment="Center">
                            <Path Data="M3,11 L17,11 M12,5 L18,11 L12,17"
                                  Stroke="#9AA3B2" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Viewbox>
                        <Border Background="#E6F0FF" CornerRadius="11" Padding="22,12,22,12">
                            <TextBlock FontSize="16" Foreground="#1757EA" VerticalAlignment="Center">
                                <Run Text="Phiên bản mới: "/><Run x:Name="RunNew" Text="1.2.1" FontWeight="Bold" Foreground="#1757EA"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Tiêu đề tiến trình -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,24,0,10">
                        <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                            <Path Data="M7,5 L19,5 M7,11 L19,11 M7,17 L19,17 M3,5 L4.4,5 M3,11 L4.4,11 M3,17 L4.4,17"
                                  Stroke="#2F6BFF" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <TextBlock Text="Tiến trình cập nhật" FontSize="21" FontWeight="SemiBold"
                                   Foreground="#071338" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Thanh tiến trình + phần trăm -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="ProgressBarMain" Grid.Column="0"
                                     Style="{StaticResource ModernProgressBar}" Value="68"
                                     VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtPercent" Grid.Column="1" Text="68%"
                                   FontSize="30" FontWeight="Bold" Foreground="#1757EA"
                                   VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </Grid>

                    <!-- Dòng trạng thái + khung 3 bước -->
                    <StackPanel Grid.Row="7" VerticalAlignment="Top">
                        <TextBlock x:Name="TxtStatus" Text="Đang tải gói cập nhật..."
                                   FontSize="16" Foreground="#6E778C" Margin="2,12,0,0"/>

                        <Border Background="#FCFDFF" BorderBrush="#E1E7F1" BorderThickness="1"
                                CornerRadius="14" Padding="24,16,24,16" Margin="0,20,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Bước 1 -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="32" Height="32">
                                        <Ellipse x:Name="Step1Circle" Fill="{StaticResource PrimaryBrush}"/>
                                        <TextBlock x:Name="Step1Num" Text="1" Foreground="White" FontWeight="Bold" FontSize="15"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        <Viewbox x:Name="Step1Check" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M4,11 L9,16 L18,5" Stroke="White" StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Viewbox>
                                    </Grid>
                                    <TextBlock x:Name="Step1Label" Text="Kiểm tra phiên bản" FontSize="16" FontWeight="SemiBold"
                                               Foreground="#071338" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>

                                <Rectangle Grid.Column="1" Width="1" Fill="#E1E7F1" Margin="18,4,18,4"/>

                                <!-- Bước 2 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="32" Height="32">
                                        <Ellipse x:Name="Step2Circle" Fill="{StaticResource PrimaryBrush}"/>
                                        <TextBlock x:Name="Step2Num" Text="2" Foreground="White" FontWeight="Bold" FontSize="15"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Viewbox x:Name="Step2Check" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Path Data="M4,11 L9,16 L18,5" Stroke="White" StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Viewbox>
                                    </Grid>
                                    <TextBlock x:Name="Step2Label" Text="Tải bản cập nhật" FontSize="16" FontWeight="SemiBold"
                                               Foreground="#1757EA" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>

                                <Rectangle Grid.Column="3" Width="1" Fill="#E1E7F1" Margin="18,4,18,4"/>

                                <!-- Bước 3 -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="32" Height="32">
                                        <Ellipse x:Name="Step3Circle" Fill="#E4E9F2"/>
                                        <TextBlock x:Name="Step3Num" Text="3" Foreground="#9AA3B2" FontWeight="Bold" FontSize="15"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Viewbox x:Name="Step3Check" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Path Data="M4,11 L9,16 L18,5" Stroke="White" StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Viewbox>
                                    </Grid>
                                    <TextBlock x:Name="Step3Label" Text="Cài đặt" FontSize="16" FontWeight="SemiBold"
                                               Foreground="#9AA3B2" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Nút dưới cùng -->
                    <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Button x:Name="BtnExit" Style="{StaticResource OutlineButtonStyle}"
                                Width="230" Height="62" Margin="0,0,18,0"
                                Background="White" BorderBrush="#D5DBE6" BorderThickness="1"
                                Click="BtnExit_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                    <Path Data="M5,5 L15,15 M15,5 L5,15" Stroke="#071338" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Thoát" FontSize="19" FontWeight="SemiBold"
                                           Foreground="#071338" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnUpdating" Style="{StaticResource PrimaryButtonStyle}"
                                Width="260" Height="62" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <!-- icon loading xoay -->
                                <Viewbox Width="22" Height="22" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Viewbox.RenderTransform>
                                        <RotateTransform x:Name="BtnSpinnerRotate" Angle="0"/>
                                    </Viewbox.RenderTransform>
                                    <Canvas Width="100" Height="100">
                                        <Path Stroke="White" StrokeThickness="9"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 50,8 A 42,42 0 1 1 8,50"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="TxtUpdating" Text="Đang cập nhật" FontSize="19" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
